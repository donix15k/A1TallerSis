PORT=4007
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@xxxxx.pooler.supabase.com:6543/postgres
# Facturacion: de aqui se consulta la factura (ver FacturacionProxy). Con docker compose se pisa
# con http://facturacion:4002 (ver Back/docker-compose.yml).
FACTURACION_URL=http://localhost:4002
# Plazo maximo para devolver, en dias calendario desde la fecha de la factura (hora de Bolivia).
PLAZO_DEVOLUCION_DIAS=7
# Monto (en Bs) a partir del cual una devolucion requiere la autorizacion del supervisor (se marca si lo supera).
LIMITE_AUTORIZACION_BS=500

# Gestion de Caja: de aqui se consulta el turno y el efectivo esperado, y se registra la salida de efectivo del reembolso.
# Con docker compose se pisa con http://gestion_caja:4004 (ver Back/docker-compose.yml).
GESTION_CAJA_URL=http://localhost:4004

# Pasarela de pagos (reversion de cobros con tarjeta/QR). Sin PASARELA_URL la pasarela es SIMULADA (acepta todo).
# Un envio que falla se reintenta con espera creciente (PASARELA_ESPERA_SEG, 2x en cada fallo) hasta PASARELA_MAX_INTENTOS.
# PASARELA_JOB_INTERVALO_SEG: cada cuanto el servicio revisa los envios pendientes (0 = no revisar).
PASARELA_URL=
PASARELA_MAX_INTENTOS=5
PASARELA_ESPERA_SEG=30
PASARELA_JOB_INTERVALO_SEG=30

# Correo de la nota de credito (TDSI-59). Sin SMTP_* el envio se SIMULA (queda registrado como SIMULADO y no sale nada).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=contraseña_de_aplicacion_de_16_caracteres
SMTP_FROM="Vortrix <tu_correo@gmail.com>"
# Datos de la empresa que salen en la nota de credito (opcionales).
EMPRESA_NOMBRE=Vortrix
EMPRESA_DIRECCION=Av. Principal s/n, Bolivia
EMPRESA_NIT=1009876015

# Tarea diaria que marca EXPIRADO los vales vencidos (0 = desactivada).
VALES_JOB_INTERVALO_HORAS=24
